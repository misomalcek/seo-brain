{
  "productName": "SEO Brain",
  "version": "0.1.2",
  "identifier": "com.misomalcek.seo-brain",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:47321",
    "beforeBuildCommand": "node ../../scripts/stage-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SEO Brain",
        "url": "index.html",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/brain-api/": "brain-api/",
      "resources/brain-chat/": "brain-chat/",
      "resources/node/": "node/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
